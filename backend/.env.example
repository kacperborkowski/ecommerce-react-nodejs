# Copy this file to .env and set your own values:
#   cp .env.example .env
# .env is ignored by git, so real passwords never end up in the repository.

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For local development use the same credentials as in the root .env (Docker Compose)
DATABASE_URL=postgres://shop:change-me@localhost:5432/shop?sslmode=disable
